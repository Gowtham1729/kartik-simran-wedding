---
import Base from "../layouts/Base.astro";
import { namesLine } from "../lib/format";
import { wedding } from "../config/wedding";

const home = import.meta.env.BASE_URL;
---
<Base title={`Page not found, ${namesLine(wedding)}`} description="That address is not part of this site.">
  <section class="missing" aria-labelledby="missing-title">
    <h1 id="missing-title">Page not found</h1>
    <p>That address is not part of this site.</p>
    <p><a href={home}>{namesLine(wedding)}</a></p>
  </section>
</Base>
