---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Story from "../components/Story.astro";
import Celebrations from "../components/Celebrations.astro";
import Gallery from "../components/Gallery.astro";
import Travel from "../components/Travel.astro";
import Faq from "../components/Faq.astro";
import Reply from "../components/Reply.astro";
import { eventJsonLd, pageDescription, pageTitle } from "../lib/content";
---
<Base title={pageTitle()} description={pageDescription()} jsonLd={eventJsonLd()}>
  <Hero />
  <Story />
  <Celebrations />
  <Gallery />
  <Travel />
  <Faq />
  <Reply />
</Base>
