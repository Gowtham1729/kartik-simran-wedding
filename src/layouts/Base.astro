---
import "../styles/global.css";
import serifUrl from "../assets/fonts/instrument-serif.woff2";
import serifItalicUrl from "../assets/fonts/instrument-serif-italic.woff2";
import sansUrl from "../assets/fonts/manrope-400.woff2";
import sansMediumUrl from "../assets/fonts/manrope-500.woff2";
import { pageUrl } from "../config/site";
import { wedding } from "../config/wedding";
import { pageTitle } from "../lib/content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  jsonLd?: string | null;
}

const { title, description, jsonLd = null } = Astro.props;
const canonical = pageUrl();
const image = pageUrl("og.png");
const imageAlt = pageTitle();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansMediumUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #f7f1e6; }
      .site-header { height: 4.25rem; overflow: hidden; position: relative; z-index: 6; background: transparent; }
      .nav, .reply-btn { display: none; }
      .hero { display: grid; grid-template-rows: 30svh minmax(0, 1fr) auto; height: 100svh; margin-top: -4.25rem; overflow: hidden; color: #f7f1e6; background: linear-gradient(180deg, #f6ddd2 0%, #f3d0c6 18%, #e7b4be 28%, #c94b78 40%, #ce266e 56%, #b41d58 72%, #9e1a4e 86%, #8f1844 94%, #c2412e 98%, #e39a14 100%); }
      .hero-sky { position: absolute; inset: 0; }
      .toran { width: 100%; height: 100%; }
      .hero-copy { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 0; text-align: center; }
      .hero-meta { text-align: center; padding: 0 1.25rem clamp(1.35rem, 4.5svh, 2.75rem); }
      .names { margin: 0; font-weight: 400; font-size: clamp(4.75rem, 22vw, 6.5rem); line-height: 0.84; letter-spacing: -0.035em; color: #f7f1e6; }
      .names .line, .names .and { display: block; white-space: nowrap; }
      .names .and { font-size: 0.38em; line-height: 1.1; margin: 0.18em 0 0.08em; letter-spacing: 0; }
      .hero-meta .when, .hero-meta .where, .hero-meta .countdown { margin: 0; font-weight: 500; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: #f7f1e6; }
      @media (max-height: 760px) and (max-width: 879px) {
        .names { font-size: clamp(3.5rem, 16vw, 4.6rem); }
      }
      @media (min-width: 880px) {
        .header-tools, .nav, .reply-btn { display: flex; }
        .header-tools { align-items: center; gap: 1.2rem; margin-left: auto; }
        .names { font-size: clamp(4.75rem, 7vw, 7rem); }
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F1E6" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={`${wedding.partnerOne} and ${wedding.partnerTwo}`} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="arch-clip" clipPathUnits="objectBoundingBox">
          <path d="M0.14,1 L0.14,0.484 C0.14,0.281 0.32,0.125 0.5,0.047 C0.68,0.125 0.86,0.281 0.86,0.484 L0.86,1 Z"></path>
        </clipPath>
        <filter id="arch-grain" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"></feTurbulence>
          <feColorMatrix type="saturate" values="0"></feColorMatrix>
        </filter>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
