---
import "../styles/global.css";
import serifUrl from "../assets/fonts/instrument-serif.woff2";
import serifItalicUrl from "../assets/fonts/instrument-serif-italic.woff2";
import sansUrl from "../assets/fonts/manrope-400.woff2";
import sansMediumUrl from "../assets/fonts/manrope-500.woff2";
import { pageUrl } from "../config/site";
import { wedding } from "../config/wedding";
import { assetPath, imageSrcSet, pageTitle } from "../lib/content";

const heroSrc = wedding.heroPhoto.src.trim();
const heroSrcSet = imageSrcSet(wedding.heroPhoto);
const heroSizes = "(min-width: 880px) 50vw, 74vw";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  jsonLd?: string | null;
}

const { title, description, jsonLd = null } = Astro.props;
const canonical = pageUrl();
const image = pageUrl("og.png");
const imageAlt = pageTitle();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansMediumUrl} as="font" type="font/woff2" crossorigin />
    {heroSrc && (
      <link
        rel="preload"
        as="image"
        href={assetPath(wedding.heroPhoto.narrow?.src || heroSrc)}
        imagesrcset={heroSrcSet || undefined}
        imagesizes={heroSrcSet ? heroSizes : undefined}
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #f7f1e6; color: #123d2f; }
      .site-header { position: sticky; top: 0; display: flex; align-items: center; height: 4.25rem; background: #f7f1e6; }
      .nav ul { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
      .hero { display: grid; padding: 0.6rem 1.25rem 3.25rem; }
      .hero-stage { position: relative; height: 0; margin-top: 0.65rem; padding-bottom: 120%; }
      .hero-main, .hero-side { position: absolute; overflow: hidden; margin: 0; }
      .hero-main { top: 0; right: 0; width: 76%; height: 84%; }
      .hero-side { left: 0; bottom: 0; width: 48%; height: 42%; }
      .names { margin: 0; font-weight: 400; font-size: clamp(4.4rem, 20vw, 6rem); line-height: 0.84; letter-spacing: -0.04em; }
      .names .line, .names .and { display: block; }
      .names .and { font-size: 0.38em; line-height: 1; margin: 0.16em 0 0.06em; }
      @media (min-width: 880px) {
        .hero { grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.2fr); align-items: end; min-height: calc(100svh - 4.25rem); padding-bottom: 3.5rem; }
        .hero-stage { margin-top: 0; padding-bottom: 112%; }
        .names { font-size: clamp(4.8rem, 6.4vw, 7.4rem); }
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F1E6" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={`${wedding.partnerOne} and ${wedding.partnerTwo}`} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
