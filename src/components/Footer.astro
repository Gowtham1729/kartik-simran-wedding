---
import { wedding } from "../config/wedding";
import { heroModel } from "../lib/content";

const hero = heroModel(wedding);
---
<footer class="footer">
  <p class="sign">
    <span translate="no">{wedding.partnerOne}</span>
    <span class="and">and</span>
    <span translate="no">{wedding.partnerTwo}</span>
  </p>
  {hero.longDate && <p class="sign-date"><time datetime={wedding.date ?? undefined}>{hero.longDate}</time></p>}
</footer>
