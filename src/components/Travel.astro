---
import { wedding } from "../config/wedding";
import { httpUrl } from "../lib/content";

const notes = wedding.travel.notes.trim();
const stays = wedding.travel.stays.filter((stay) => stay.name.trim() || stay.detail.trim());
const open = !notes && stays.length === 0;
---
<section class="section rise" id="travel" aria-labelledby="travel-title">
  <div class="split">
    <h2 id="travel-title">Travel</h2>
    <div class="split-body">
      {open ? (
        <>
          <p class="kicker">Placeholder</p>
          <p class="placeholder">Travel notes have not been added.</p>
        </>
      ) : (
        <>
          {notes && <p>{notes}</p>}
          {stays.length > 0 && (
            <ul class="stays">
              {stays.map((stay) => {
                const url = httpUrl(stay.url);
                return (
                  <li>
                    <h3>{stay.name.trim() || "Place to be confirmed"}</h3>
                    {stay.detail.trim() && <p>{stay.detail.trim()}</p>}
                    {url && (
                      <p>
                        <a href={url} target="_blank" rel="noopener">
                          Open<span class="visually-hidden"> (opens in a new tab)</span>
                        </a>
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </>
      )}
    </div>
  </div>
</section>
