      <ellipse cx="36.41" cy="32.89" rx="3.8" ry="5.4" fill="#E07A1F" transform="rotate(101.5 36.41 32.89)"></ellipse>
      <ellipse cx="34.05" cy="36.01" rx="3.8" ry="5.4" fill="#E07A1F" transform="rotate(152.9 34.05 36.01)"></ellipse>
      <ellipse cx="30.15" cy="36.10" rx="3.8" ry="5.4" fill="#E07A1F" transform="rotate(204.3 30.15 36.10)"></ellipse>
