      <ellipse cx="35.45" cy="29.11" rx="3.8" ry="5.4" fill="#E07A1F" transform="rotate(410.0 35.45 29.11)"></ellipse>
      <circle cx="32" cy="32" r="7.4" fill="#7A320C"></circle>
      <circle cx="30.8" cy="30.6" r="2.5" fill="#E07A1F"></circle>
    </symbol>
    <symbol id="toran-leaf" viewBox="0 0 24 10">
      <path fill="#123D2F" d="M1.1 5C6.2 0.7 16.2 0.35 22.9 5C16.2 9.65 6.2 9.3 1.1 5Z"></path>
      <path fill="none" stroke="#A9D4BE" stroke-width="1.15" stroke-linecap="round" d="M3.4 5C9.4 4.55 16.4 4.5 20.8 5"></path>
    </symbol>
    <symbol id="toran-bell" viewBox="0 0 14 16">
      <circle cx="7" cy="1.15" r="0.95" fill="none" stroke="#CE266E" stroke-width="0.9"></circle>
      <path stroke="#CE266E" stroke-width="0.8" stroke-linecap="round" d="M7 2.05V3.25"></path>
      <path fill="#CE266E" d="M4.5 3.6C3 3.95 1.95 5.6 1.6 7.4C1.3 8.95 0.75 9.55 0.95 10.15H13.05C13.25 9.55 12.7 8.95 12.4 7.4C12.05 5.6 11 3.95 9.5 3.6C8.8 3.4 7.9 3.9 7 3.9C6.1 3.9 5.2 3.4 4.5 3.6Z"></path>
      <path fill="#9E1A54" d="M3.15 8.65C4.3 9.4 5.6 9.65 7 9.65C8.4 9.65 9.7 9.4 10.85 8.65C10.2 9.2 8.7 9.95 7 9.95C5.3 9.95 3.8 9.2 3.15 8.65Z"></path>
      <path stroke="#CE266E" stroke-width="0.85" stroke-linecap="round" d="M4.55 10.4L3.95 14.7M7 10.5V15.2M9.45 10.4L10.05 14.7"></path>
    </symbol>
  </defs>
  {toran.leaves.map((leaf) => (
    <use
      class="toran-part"
      href="#toran-leaf"
      data-role="leaf"
      data-strand={leaf.strand}
      width={toran.leafLength.toFixed(2)}
      height={toran.leafWidth.toFixed(2)}
      transform={placed(leaf.x, leaf.y, toran.leafLength, toran.leafWidth, leaf.rot)}
    />
  ))}
  {toran.blooms.map((bloom) => (
    <use
      class="toran-part"
      href="#toran-marigold"
      data-role={bloom.role}
      data-strand={bloom.strand}
      width={toran.bloom.toFixed(2)}
      height={toran.bloom.toFixed(2)}
      transform={placed(bloom.x, bloom.y, toran.bloom, toran.bloom, bloom.rot)}
    />
  ))}
  {toran.bells.map((bell) => (
    <use
      class="toran-part"
      href="#toran-bell"
      data-role="bell"
      data-strand={bell.strand}
      width={toran.bellWidth.toFixed(2)}
      height={toran.bellHeight.toFixed(2)}
      transform={placed(bell.x, bell.y, toran.bellWidth, toran.bellHeight, 0)}
    />
  ))}
</svg>
<script>
  import { layoutToran } from "../lib/toran";

  const paint = () => {
    document.querySelectorAll<SVGSVGElement>("[data-toran]").forEach((svg) => {
      const rect = svg.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;
      if (w < 8 || h < 8) return;
      const header = document.querySelector(".site-header");
      const headerBottom = header ? header.getBoundingClientRect().bottom : 0;
      const inset = Math.max(0, headerBottom - rect.top);
      const prevW = Number(svg.dataset.laidW || 0);
      const prevH = Number(svg.dataset.laidH || 0);
      const prevInset = Number(svg.dataset.laidInset || 0);
      if (Math.abs(prevW - w) < 0.5 && Math.abs(prevH - h) < 0.5 && Math.abs(prevInset - inset) < 0.5) return;
      svg.dataset.laidW = String(w);
      svg.dataset.laidH = String(h);
      svg.dataset.laidInset = String(inset);

      const layout = layoutToran(w, h, inset);
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      svg.setAttribute("preserveAspectRatio", "none");
      svg.querySelectorAll(".toran-part").forEach((node) => node.remove());

      const ns = "http://www.w3.org/2000/svg";
      const add = (
        href: string,
        x: number,
        y: number,
        partW: number,
        partH: number,
        rot: number,
        role: string,
        strand: number,
      ) => {
        const el = document.createElementNS(ns, "use");
        el.setAttribute("class", "toran-part");
        el.setAttribute("href", href);
        el.setAttribute("width", partW.toFixed(2));
        el.setAttribute("height", partH.toFixed(2));
        el.setAttribute("data-role", role);
        el.setAttribute("data-strand", String(strand));
        el.setAttribute(
          "transform",
          `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${rot.toFixed(2)}) translate(${(-partW / 2).toFixed(2)} ${(-partH / 2).toFixed(2)})`,
        );
        svg.appendChild(el);
      };

      for (const leaf of layout.leaves) {
        add("#toran-leaf", leaf.x, leaf.y, layout.leafLength, layout.leafWidth, leaf.rot, "leaf", leaf.strand);
      }
      for (const bloom of layout.blooms) {
        add("#toran-marigold", bloom.x, bloom.y, layout.bloom, layout.bloom, bloom.rot, bloom.role, bloom.strand);
      }
      for (const bell of layout.bells) {
        add("#toran-bell", bell.x, bell.y, layout.bellWidth, layout.bellHeight, 0, "bell", bell.strand);
      }
    });
  };

  const kick = () => {
    paint();
    requestAnimationFrame(paint);
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", kick);
  else kick();
  window.addEventListener("resize", paint, { passive: true });
  const band = document.querySelector("[data-toran]");
  if (band && "ResizeObserver" in window) new ResizeObserver(() => paint()).observe(band);
</script>
