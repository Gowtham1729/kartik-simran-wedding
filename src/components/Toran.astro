---
import { layoutToran } from "../lib/toran";

const toran = layoutToran(390, Math.round(844 * 0.3), 68);
const placed = (x: number, y: number, w: number, h: number, rot: number) =>
  `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${rot.toFixed(2)}) translate(${(-w / 2).toFixed(2)} ${(-h / 2).toFixed(2)})`;
---
<svg class="toran" data-toran viewBox={`0 0 390 ${Math.round(844 * 0.3)}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="toran-marigold" viewBox="0 0 64 64">
      <ellipse cx="32.00" cy="16.50" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(0.0 32.00 16.50)"></ellipse>
      <ellipse cx="41.11" cy="19.46" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(36.0 41.11 19.46)"></ellipse>
      <ellipse cx="46.74" cy="27.21" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(72.0 46.74 27.21)"></ellipse>
      <ellipse cx="46.74" cy="36.79" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(108.0 46.74 36.79)"></ellipse>
      <ellipse cx="41.11" cy="44.54" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(144.0 41.11 44.54)"></ellipse>
      <ellipse cx="32.00" cy="47.50" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(180.0 32.00 47.50)"></ellipse>
      <ellipse cx="22.89" cy="44.54" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(216.0 22.89 44.54)"></ellipse>
      <ellipse cx="17.26" cy="36.79" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(252.0 17.26 36.79)"></ellipse>
      <ellipse cx="17.26" cy="27.21" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(288.0 17.26 27.21)"></ellipse>
      <ellipse cx="22.89" cy="19.46" rx="8.4" ry="14.2" fill="#F2A12C" transform="rotate(324.0 22.89 19.46)"></ellipse>
      <ellipse cx="36.08" cy="19.45" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(18.0 36.08 19.45)"></ellipse>
      <ellipse cx="42.68" cy="24.24" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(54.0 42.68 24.24)"></ellipse>
      <ellipse cx="45.20" cy="32.00" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(90.0 45.20 32.00)"></ellipse>
      <ellipse cx="42.68" cy="39.76" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(126.0 42.68 39.76)"></ellipse>
      <ellipse cx="36.08" cy="44.55" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(162.0 36.08 44.55)"></ellipse>
      <ellipse cx="27.92" cy="44.55" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(198.0 27.92 44.55)"></ellipse>
      <ellipse cx="21.32" cy="39.76" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(234.0 21.32 39.76)"></ellipse>
      <ellipse cx="18.80" cy="32.00" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(270.0 18.80 32.00)"></ellipse>
      <ellipse cx="21.32" cy="24.24" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(306.0 21.32 24.24)"></ellipse>
      <ellipse cx="27.92" cy="19.45" rx="7.2" ry="12.4" fill="#E07A1F" transform="rotate(342.0 27.92 19.45)"></ellipse>
      <ellipse cx="34.81" cy="24.30" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(20.1 34.81 24.30)"></ellipse>
      <ellipse cx="39.43" cy="28.54" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(65.1 39.43 28.54)"></ellipse>
      <ellipse cx="39.70" cy="34.81" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(110.1 39.70 34.81)"></ellipse>
      <ellipse cx="35.46" cy="39.43" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(155.1 35.46 39.43)"></ellipse>
      <ellipse cx="29.19" cy="39.70" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(200.1 29.19 39.70)"></ellipse>
      <ellipse cx="24.57" cy="35.46" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(245.1 24.57 35.46)"></ellipse>
      <ellipse cx="24.30" cy="29.19" rx="5.6" ry="8.6" fill="#F2A12C" transform="rotate(290.1 24.30 29.19)"></ellipse>
