---
import { wedding } from "../config/wedding";
import { detailRows } from "../lib/content";

const rows = detailRows(wedding);
const intro = wedding.intro.trim();
---
<section class="section" id="details" aria-labelledby="details-title">
  <div class="section-intro">
    <h2 id="details-title" class="sheet-title">Details</h2>
    {intro && <p class="lede">{intro}</p>}
  </div>
  <dl class="sheet">
    {rows.map((row) => (
      <div class="sheet-row">
        <dt>{row.label}</dt>
        <dd class:list={[{ "is-open": row.open }]}>
          {row.href ? <a href={row.href}>{row.value}</a> : row.value}
        </dd>
      </div>
    ))}
  </dl>
</section>
