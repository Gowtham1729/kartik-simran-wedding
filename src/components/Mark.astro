---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---
<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path d="M16 2.2 29.2 16 16 29.8 2.8 16Z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
  <path class="mark-petal" d="M16 9.2 22.6 16 16 22.8 9.4 16Z"></path>
  <path d="M16 9.2v13.6M9.4 16h13.2" fill="none" stroke="currentColor" stroke-width="1.15"></path>
</svg>
