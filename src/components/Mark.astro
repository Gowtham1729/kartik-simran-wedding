---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---
<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="13.5" cy="13.5" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
  <path
    d="M13.5 2.2v5.2M13.5 19.6v6.2M2.2 13.5h5.2M19.6 13.5h6.2"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></path>
  <rect class="mark-square" x="16.4" y="16.4" width="6.6" height="6.6"></rect>
</svg>
