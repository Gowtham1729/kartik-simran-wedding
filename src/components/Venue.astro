---
import { wedding } from "../config/wedding";
import { httpUrl } from "../lib/content";

const name = wedding.venue.name.trim();
const address = wedding.venue.address.trim();
const notes = wedding.venue.notes.trim();
const map = httpUrl(wedding.venue.mapsUrl);
const open = !name && !address && !notes;
---
<section class="section rise" id="venue" aria-labelledby="venue-title">
  <div class="split">
    <h2 id="venue-title">Venue</h2>
    <div class="split-body">
      {open && <p class="kicker">Placeholder</p>}
      <p class="lead">{name || "The venue has not been named."}</p>
      {address && <p>{address}</p>}
      {notes && <p>{notes}</p>}
      {map && (
        <p>
          <a href={map} target="_blank" rel="noopener">
            Open the map<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      )}
    </div>
  </div>
</section>
