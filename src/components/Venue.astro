---
import { wedding } from "../config/wedding";
import { venueHasDetail } from "../lib/content";
import Arrow from "./Arrow.astro";

const venue = wedding.venue;
const show = venueHasDetail(wedding);
const maps = venue.mapsUrl.trim();
---
{show && (
  <section class="section" id="venue" aria-labelledby="venue-title">
    <h2 id="venue-title">Venue</h2>
    <div class="prose">
      <p class="place-name">{venue.name.trim() || "To be announced"}</p>
      {venue.address.trim() ? (
        <address>{venue.address.trim()}</address>
      ) : (
        <p class="is-open">Address to be announced</p>
      )}
      {venue.notes.trim() && <p>{venue.notes.trim()}</p>}
      {maps ? (
        <p>
          <a class="text-link" href={maps} target="_blank" rel="noopener noreferrer">
            Open the map
            <Arrow />
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      ) : (
        <p class="is-open">Map to be announced</p>
      )}
    </div>
  </section>
)}
