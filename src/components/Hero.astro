---
import { wedding } from "../config/wedding";
import { assetPath, heroModel } from "../lib/content";
import Toran from "./Toran.astro";

const hero = heroModel(wedding);
const [first, second] = hero.partners;
const image = hero.image;
const photo = image.src.trim();
---
<section class:list={["hero", photo && "has-photo"]} id="top" aria-labelledby="hero-title">
  <div class="hero-sky" aria-hidden="true">
    {photo && (
      <img
        class="hero-photo"
        src={assetPath(photo)}
        alt=""
        width={image.width}
        height={image.height}
        decoding="async"
        fetchpriority="high"
      />
    )}
    <div class="hero-wash"></div>
    {photo && <div class="hero-scrim"></div>}
    <svg class="hero-grain" focusable="false">
      <rect width="100%" height="100%" filter="url(#arch-grain)"></rect>
    </svg>
  </div>
  <Toran />
  <div class="hero-copy">
    <h1 id="hero-title" class="names">
      <span class="line" translate="no">{first}</span>
      <span class="and">and</span>
      <span class="line" translate="no">{second}</span>
    </h1>
    {hero.gurmukhi && (
      <p class="gurmukhi" lang="pa" translate="no">
        <span>{hero.gurmukhi.one}</span>
        <span>{hero.gurmukhi.two}</span>
      </p>
    )}
  </div>
  <div class="hero-meta">
    {hero.parts && (
      <p class="when">
        <span class="visually-hidden">{hero.longDate}</span>
        <span aria-hidden="true">{hero.parts.weekdayLong}, {hero.parts.day} {hero.parts.monthLong} {hero.parts.year}</span>
      </p>
    )}
    <p class="where">{hero.city}</p>
    {hero.target && (
      <div class="count-block">
        <p class="countdown" data-countdown data-target={hero.target}>
          <span data-count-text>{hero.phrase}</span>
        </p>
        <p class="count-done" data-count-done data-passed={hero.passed} hidden>{hero.here}</p>
        <p class="visually-hidden" data-count-live aria-live="polite"></p>
        <noscript>
          <p class="count-note">The live count needs JavaScript. The date above is the one to keep.</p>
        </noscript>
        <script is:inline>
          (function () {
            var root = document.querySelector("[data-countdown]");
            if (!root) return;
            var target = new Date(root.getAttribute("data-target") || "");
            if (isNaN(target.getTime())) return;
            var text = root.querySelector("[data-count-text]");
            var done = document.querySelector("[data-count-done]");
            var live = document.querySelector("[data-count-live]");
            var lastSpoken = 0;

            function parts(ms) {
              var s = Math.floor(ms / 1000);
              return {
                days: Math.floor(s / 86400),
                hours: Math.floor((s % 86400) / 3600),
                minutes: Math.floor((s % 3600) / 60)
              };
            }

            function phrase(v) {
              if (v.days > 1) return v.days + " days to go";
              if (v.days === 1) return "1 day to go";
              if (v.hours > 1) return v.hours + " hours to go";
              if (v.hours === 1) return "1 hour to go";
              if (v.minutes > 1) return v.minutes + " minutes to go";
              return "Less than a minute to go";
            }

            function finish(ms) {
              root.hidden = true;
              if (done) {
                if (ms < -36 * 60 * 60 * 1000 && done.getAttribute("data-passed")) {
                  done.textContent = done.getAttribute("data-passed");
                }
                done.hidden = false;
                if (live) live.textContent = done.textContent;
              }
            }

            function tick() {
              var ms = target.getTime() - Date.now();
              if (ms <= 0) {
                finish(ms);
                return false;
              }
              var values = parts(ms);
              var line = phrase(values);
              if (text && text.textContent !== line) text.textContent = line;
              var now = Date.now();
              if (live && now - lastSpoken > 60000) {
                live.textContent = values.days + " days, " + values.hours + " hours, " + values.minutes + " minutes";
                lastSpoken = now;
              }
              return true;
            }

            if (!tick()) return;
            var timer = setInterval(function () {
              if (!tick()) clearInterval(timer);
            }, 30000);
          })();
        </script>
      </div>
    )}
  </div>
</section>
