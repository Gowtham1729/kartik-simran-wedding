---
import { wedding } from "../config/wedding";
import { navItems, rsvpLink } from "../lib/content";
import { namesLine } from "../lib/format";

const items = navItems();
const reply = rsvpLink(wedding);
const home = import.meta.env.BASE_URL;
const one = wedding.partnerOne.trim().charAt(0);
const two = wedding.partnerTwo.trim().charAt(0);
---
<header class="site-header">
  <a class="mark" href={home} aria-label={`${one} & ${two}, ${namesLine(wedding)}`}>
    <span translate="no">{one}</span>
    <i>&</i>
    <span translate="no">{two}</span>
  </a>
  <nav class="nav" aria-label="Sections">
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      {reply && (
        <li>
          <a href={reply.href} target={reply.external ? "_blank" : undefined} rel={reply.external ? "noopener" : undefined}>
            {reply.label}
            {reply.external && <span class="visually-hidden"> (opens in a new tab)</span>}
          </a>
        </li>
      )}
    </ul>
  </nav>
</header>
