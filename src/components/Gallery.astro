---
import { wedding } from "../config/wedding";
import { assetPath } from "../lib/content";

const images = wedding.gallery.filter((image) => image.src.trim());
---
{images.length > 0 && (
  <section class="section" id="gallery" aria-labelledby="gallery-title">
    <h2 id="gallery-title">Photographs</h2>
    <ul class="gallery">
      {images.map((image) => (
        <li>
          <figure>
            <img
              src={assetPath(image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
            {image.alt.trim() && <figcaption>{image.alt}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  </section>
)}
