---
import { wedding } from "../config/wedding";
import { assetPath } from "../lib/content";

const images = wedding.gallery.filter((image) => image.src.trim());
const frames = ["m1", "m2", "m3", "m4", "m5"];
---
<section class="section gallery rise" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-head">
    <p class="kicker">Details</p>
    <h2 id="gallery-title">Gallery</h2>
  </div>
  {images.length === 0 ? (
    <p class="placeholder">Photographs will be added here.</p>
  ) : (
    <div class="masonry">
      {images.map((image, index) => (
        <figure class={frames[index] ?? "m5"}>
          <img
            src={assetPath(image.src)}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  )}
</section>
