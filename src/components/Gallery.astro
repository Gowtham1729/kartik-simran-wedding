---
import { wedding } from "../config/wedding";
import Frame from "./Frame.astro";

const images = wedding.gallery;
---
<section class="section rise" id="gallery" aria-labelledby="gallery-title">
  <div class="split">
    <div>
      <h2 id="gallery-title">Photographs</h2>
      {images.every((image) => !image.src.trim()) && (
        <p class="kicker">Placeholder</p>
      )}
    </div>
    <ul class="frames">
      {images.map((image, index) => (
        <li>
          <Frame
            src={image.src}
            alt={image.alt || "Photograph to be added"}
            width={image.width}
            height={image.height}
            priority={index === 0 && Boolean(image.src.trim()) && !wedding.heroImage.src.trim()}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
