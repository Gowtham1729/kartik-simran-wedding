---
import { wedding } from "../config/wedding";
import { chipColor, httpUrl } from "../lib/content";

const events = wedding.events.filter((event) =>
  [event.name, event.date, event.time, event.place, event.note, event.dress].some((value) => value.trim())
);
---
<section class="band rise" id="schedule" aria-labelledby="schedule-title">
  <div class="band-inner">
    <div class="band-copy">
      <h2 id="schedule-title">Functions</h2>
      {events.length === 0 ? (
        <p>No function is listed until the day, the time, and the venue are confirmed.</p>
      ) : (
        <p>{events.length === 1 ? "One confirmed function." : `${events.length} confirmed functions.`}</p>
      )}
    </div>
    <ol class="timeline">
      {events.length === 0 ? (
        <li class="is-placeholder">
          <span class="dot" aria-hidden="true"></span>
          <p class="kicker">Placeholder</p>
          <h3>Function to be confirmed</h3>
          <p>Day and time to be confirmed</p>
          <p>Venue to be confirmed</p>
          <p class="dress">Dress to be confirmed</p>
        </li>
      ) : (
        events.map((event) => {
          const map = httpUrl(event.mapsUrl);
          const color = chipColor(event.dressColor);
          const when = [event.date.trim(), event.time.trim()].filter(Boolean).join(", ");
          return (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <h3>{event.name.trim() || "Name to be confirmed"}</h3>
              <p>{when || "Day and time to be confirmed"}</p>
              <p>
                {event.place.trim() || "Venue to be confirmed"}
                {map && (
                  <>
                    {" "}
                    <a href={map} target="_blank" rel="noopener">
                      Map<span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </>
                )}
              </p>
              {event.note.trim() && <p class="note">{event.note.trim()}</p>}
              {(event.dress.trim() || color) && (
                <p class="dress">
                  {color && <span class="chip" style={`background:${color}`} aria-hidden="true"></span>}
                  {event.dress.trim() || "Dress"}
                </p>
              )}
            </li>
          );
        })
      )}
    </ol>
  </div>
</section>
