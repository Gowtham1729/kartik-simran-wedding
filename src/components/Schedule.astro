---
import { wedding } from "../config/wedding";

const events = wedding.events;
---
{events.length > 0 && (
  <section class="section" id="schedule" aria-labelledby="schedule-title">
    <h2 id="schedule-title">Schedule</h2>
    <ol class="schedule">
      {events.map((event, index) => (
        <li>
          <p class="schedule-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
          <div>
            <h3>{event.name.trim() || "To be announced"}</h3>
            <p class="schedule-when">
              {[event.date.trim(), event.time.trim()].filter(Boolean).join("  ·  ") || "To be announced"}
            </p>
            {event.place.trim() && <p class="schedule-place">{event.place.trim()}</p>}
            {event.note.trim() && <p class="schedule-note">{event.note.trim()}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
