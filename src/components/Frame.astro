---
import { assetPath } from "../lib/content";

interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  /** Hero frames stay quiet. Gallery frames show the placeholder line. */
  caption?: boolean;
  /** Marigold toran across the top of the arch. Hero only. */
  doorway?: boolean;
}

const {
  src = "",
  alt,
  width = 900,
  height = 1152,
  priority = false,
  caption = true,
  doorway = false,
} = Astro.props;
const file = src.trim();
---
<div class="frame">
  <div class="frame-clip">
    {file ? (
      <img
        src={assetPath(file)}
        alt={alt}
        width={width}
        height={height}
        decoding="async"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />
    ) : (
      <div class="frame-hold" role="img" aria-label={alt}>
        <svg class="grain" aria-hidden="true" focusable="false">
          <rect width="100%" height="100%" filter="url(#arch-grain)"></rect>
        </svg>
        {caption && <span>{alt}</span>}
      </div>
    )}
    {doorway && (
