---
import { assetPath } from "../lib/content";

interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  /** Hero frames stay quiet. Gallery frames show the placeholder line. */
  caption?: boolean;
  /** Marigold toran across the top of the arch. Hero only. */
  doorway?: boolean;
}

const {
  src = "",
  alt,
  width = 900,
  height = 1152,
  priority = false,
  caption = true,
  doorway = false,
} = Astro.props;
const file = src.trim();
---
<div class="frame">
  <div class="frame-clip">
    {file ? (
      <img
        src={assetPath(file)}
        alt={alt}
        width={width}
        height={height}
        decoding="async"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />
    ) : (
      <div class="frame-hold" role="img" aria-label={alt}>
        <svg class="grain" aria-hidden="true" focusable="false">
          <rect width="100%" height="100%" filter="url(#arch-grain)"></rect>
        </svg>
        {caption && <span>{alt}</span>}
      </div>
    )}
    {doorway && (
      <svg class="toran" viewBox="0 0 240 78" aria-hidden="true" focusable="false">
        <path d="M8 24 C52 4 188 4 232 24" fill="none" stroke="#B08A3E" stroke-width="1" vector-effect="non-scaling-stroke"></path>
        <g fill="#E39A14">
          <circle cx="32" cy="19" r="2.1"></circle>
          <circle cx="64" cy="12" r="2.3"></circle>
          <circle cx="96" cy="8" r="2.5"></circle>
          <circle cx="120" cy="7" r="2.8"></circle>
          <circle cx="144" cy="8" r="2.5"></circle>
          <circle cx="176" cy="12" r="2.3"></circle>
          <circle cx="208" cy="19" r="2.1"></circle>
        </g>
        <g fill="none" stroke="#B08A3E" stroke-width="1" vector-effect="non-scaling-stroke">
          <path d="M64 14.2 V34"></path>
          <path d="M120 9.8 V42"></path>
          <path d="M176 14.2 V32"></path>
        </g>
        <g fill="#E39A14">
          <circle cx="64" cy="36" r="1.5"></circle>
          <circle cx="120" cy="44" r="1.7"></circle>
          <circle cx="176" cy="34" r="1.5"></circle>
        </g>
      </svg>
    )}
  </div>
  <svg class="frame-stroke" viewBox="0 0 100 128" preserveAspectRatio="none" aria-hidden="true">
    <path d="M14 128 L14 62 C14 36 32 16 50 6 C68 16 86 36 86 62 L86 128" fill="none"></path>
  </svg>
</div>
