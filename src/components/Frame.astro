---
import { assetPath } from "../lib/content";

interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  /** Hero frames stay quiet. Gallery frames show the placeholder line. */
  caption?: boolean;
  /** Marigold toran across the top of the arch. Hero only. */
  doorway?: boolean;
}

const {
  src = "",
  alt,
  width = 900,
  height = 1152,
  priority = false,
  caption = true,
  doorway = false,
} = Astro.props;
const file = src.trim();
---
<div class="frame">
  <div class="frame-clip">
    {file ? (
      <img
        src={assetPath(file)}
        alt={alt}
        width={width}
        height={height}
        decoding="async"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />
    ) : (
      <div class="frame-hold" role="img" aria-label={alt}>
        <svg class="grain" aria-hidden="true" focusable="false">
          <rect width="100%" height="100%" filter="url(#arch-grain)"></rect>
        </svg>
        {caption && <span>{alt}</span>}
      </div>
    )}
    {doorway && (
      <svg class="toran" viewBox="0 0 390 104" aria-hidden="true" focusable="false">
        <g fill="none" stroke="#B08A3E" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
          <path d="M130.5 52.9 Q137.4 45 144.7 37.1 Q152.7 29.2 161.2 21.3 Q170.4 13.3 180.4 5.4 Q187.7 3.6 195 3.6 Q202.3 3.6 209.6 5.4 Q219.6 13.3 228.8 21.3 Q237.3 29.2 245.3 37.1 Q252.6 45 259.5 52.9"></path>
          <path d="M130.5 52.9 Q146.6 67.9 162.8 52.9 Q178.9 67.9 195 52.9 Q211.1 67.9 227.2 52.9 Q243.4 67.9 259.5 52.9"></path>
        </g>
        <g fill="#123D2F">
          <polygon points="162.8,54 167.3,64 158.3,64"></polygon>
          <polygon points="195,54 199.5,64 190.5,64"></polygon>
          <polygon points="227.2,54 231.7,64 222.7,64"></polygon>
        </g>
        <g fill="none" stroke="#B08A3E" stroke-width="1" stroke-linecap="round">
          <path d="M146.6 67.9 V72"></path>
          <path d="M162.8 64 V66"></path>
          <path d="M178.9 67.9 V72"></path>
          <path d="M195 64 V66"></path>
          <path d="M211.1 67.9 V72"></path>
          <path d="M227.2 64 V66"></path>
          <path d="M243.4 67.9 V72"></path>
        </g>
        <g stroke="#F7F1E6" stroke-width="1.25">
          <circle cx="146.6" cy="74" r="4.5" fill="#F2A12C"></circle>
          <circle cx="146.6" cy="82" r="4.5" fill="#E07A1F"></circle>
          <circle cx="162.8" cy="66" r="4.5" fill="#F2A12C"></circle>
          <circle cx="162.8" cy="73.6" r="4.5" fill="#E07A1F"></circle>
          <circle cx="162.8" cy="81.2" r="4.5" fill="#F2A12C"></circle>
          <circle cx="178.9" cy="74" r="4.5" fill="#E07A1F"></circle>
          <circle cx="178.9" cy="82.5" r="4.5" fill="#F2A12C"></circle>
          <circle cx="178.9" cy="91" r="4.5" fill="#E07A1F"></circle>
          <circle cx="195" cy="66" r="4.5" fill="#F2A12C"></circle>
          <circle cx="195" cy="73.6" r="4.5" fill="#E07A1F"></circle>
          <circle cx="195" cy="81.2" r="4.5" fill="#F2A12C"></circle>
          <circle cx="195" cy="88.8" r="4.5" fill="#E07A1F"></circle>
          <circle cx="195" cy="96.4" r="4.5" fill="#F2A12C"></circle>
          <circle cx="211.1" cy="74" r="4.5" fill="#E07A1F"></circle>
          <circle cx="211.1" cy="82.5" r="4.5" fill="#F2A12C"></circle>
          <circle cx="211.1" cy="91" r="4.5" fill="#E07A1F"></circle>
          <circle cx="227.2" cy="66" r="4.5" fill="#F2A12C"></circle>
          <circle cx="227.2" cy="73.6" r="4.5" fill="#E07A1F"></circle>
          <circle cx="227.2" cy="81.2" r="4.5" fill="#F2A12C"></circle>
          <circle cx="243.4" cy="74" r="4.5" fill="#E07A1F"></circle>
          <circle cx="243.4" cy="82" r="4.5" fill="#F2A12C"></circle>
        </g>
      </svg>
    )}
  </div>
  <svg class="frame-stroke" viewBox="0 0 100 128" preserveAspectRatio="none" aria-hidden="true">
    <path d="M14 128 L14 62 C14 36 32 16 50 6 C68 16 86 36 86 62 L86 128" fill="none"></path>
  </svg>
</div>
