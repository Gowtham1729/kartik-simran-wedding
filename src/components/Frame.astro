---
import { assetPath } from "../lib/content";

interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  /** Hero frames stay quiet. Gallery frames show the placeholder line. */
  caption?: boolean;
}

const { src = "", alt, width = 900, height = 1152, priority = false, caption = true } = Astro.props;
const file = src.trim();
---
<div class="frame">
  <div class="frame-clip">
    {file ? (
      <img
        src={assetPath(file)}
        alt={alt}
        width={width}
        height={height}
        decoding="async"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />
    ) : (
      <div class="frame-hold" role="img" aria-label={alt}>
        {caption && <span>{alt}</span>}
      </div>
    )}
  </div>
  <svg class="frame-stroke" viewBox="0 0 100 128" preserveAspectRatio="none" aria-hidden="true">
    <path d="M14 128 L14 62 C14 36 32 16 50 6 C68 16 86 36 86 62 L86 128" fill="none"></path>
  </svg>
</div>
