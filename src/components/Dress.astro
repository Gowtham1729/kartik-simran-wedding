---
import { wedding } from "../config/wedding";

const note = wedding.dressCode.trim();
---
<section class="section rise" id="dress" aria-labelledby="dress-title">
  <div class="split">
    <h2 id="dress-title">Dress</h2>
    <div class="split-body">
      {note ? (
        <p>{note}</p>
      ) : (
        <>
          <p class="kicker">Placeholder</p>
          <p class="placeholder">The dress note has not been written.</p>
        </>
      )}
    </div>
  </div>
</section>
