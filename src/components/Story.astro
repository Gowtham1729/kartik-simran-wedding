---
import { wedding } from "../config/wedding";

const paragraphs = [wedding.intro, ...wedding.story].map((p) => p.trim()).filter(Boolean);
---
<section class="section rise" id="story" aria-labelledby="story-title">
  <div class="split">
    <h2 id="story-title">Story</h2>
    <div class="split-body">
      {paragraphs.length > 0 ? (
        paragraphs.map((paragraph) => <p>{paragraph}</p>)
      ) : (
        <>
          <p class="kicker">Placeholder</p>
          <p class="placeholder">This story has not been written yet.</p>
        </>
      )}
    </div>
  </div>
</section>
