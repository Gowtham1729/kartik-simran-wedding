---
import { wedding } from "../config/wedding";

const items = wedding.faq.filter((item) => item.question.trim() && item.answer.trim());
---
{items.length > 0 && (
  <section class="section" id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    <div class="faq">
      {items.map((item) => (
        <details>
          <summary>
            <h3>{item.question.trim()}</h3>
          </summary>
          <p>{item.answer.trim()}</p>
        </details>
      ))}
    </div>
  </section>
)}
